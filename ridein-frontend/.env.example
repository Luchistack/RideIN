# Copy this file to .env and fill in your own keys. Vite only exposes
# variables prefixed VITE_ to the browser — never put a secret key here that
# isn't meant to be publicly visible in the shipped JS bundle.

# Google Maps JavaScript API key — shows the live Millennium Estate map.
# Without this, the app falls back to an illustrated placeholder map (still
# fully interactive) so it runs fine before you've set this up.
#
# Get one at https://console.cloud.google.com/google/maps-apis:
#   1. Create/select a project, enable billing (required even for free tier).
#   2. Enable the "Maps JavaScript API".
#   3. Create an API key, then restrict it (HTTP referrers = your domain(s))
#      so it can't be used from anywhere else.
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth Client ID — powers the "Continue with Google" buttons on
# login/signup. Without this, those buttons show a note explaining they're
# not configured yet, instead of silently failing.
#
# Get one at https://console.cloud.google.com/apis/credentials:
#   1. Create an OAuth client ID, type "Web application".
#   2. Under "Authorized JavaScript origins", add http://localhost:5173 for
#      dev, plus your real production URL later.
VITE_GOOGLE_CLIENT_ID=
