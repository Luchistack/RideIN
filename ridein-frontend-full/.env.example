# Copy this file to .env and fill in real values. Vite only reads
# VITE_-prefixed vars, and only at dev-server start / build time.

# Django backend base URL:
#   local dev (python manage.py runserver on :8000):
VITE_API_BASE_URL=http://localhost:8000/api/v1
#   production:
# VITE_API_BASE_URL=https://api.ridein.ng/api/v1

# Google Identity Services client ID, used by GoogleSignInButton.jsx.
# Without this set, the button renders a clearly-labeled disabled state.
VITE_GOOGLE_CLIENT_ID=
